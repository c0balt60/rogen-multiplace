{
	"source": [
		"../../src/core",
		"../../src/match"
	],
	"ts": {
		"output": "default.project.json",
		"build": "out"
	},
	"project": {
		"name": "match",
		"globIgnorePaths": [
			"**/package.json",
			"**/tsconfig.json"
		],
		"tree": {
			"$className": "DataModel",
			"ReplicatedStorage": {
				"rbxts_include": {
					"$path": "include",
					"node_modules": {
						"$className": "Folder",
						"@rbxts": {
							"$path": "../../node_modules/@rbxts"
						},
						"@flamework": {
							"$path": "../../node_modules/@flamework"
						}
					}
				}
			},
			"Players": {
				"$properties": {
					"CharacterAutoLoads": false
				}
			}
		}
	}
}
